# LLM Provider Configuration
# Choose which provider the app uses: "deepseek" or "gemini"
LLM_PROVIDER=deepseek

# DeepSeek API Configuration (required if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Configuration (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Flask secret key for sessions
FLASK_SECRET_KEY=your_secret_key_here
