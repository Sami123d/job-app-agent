# LLM Provider Configuration
# Choose which provider the app uses: "deepseek" or "gemini"
# ("gemini" uses Gemini's OpenAI-compatible endpoint and works with a free
#  Google AI Studio key; "gemini-sdk" uses the legacy google-generativeai SDK)
LLM_PROVIDER=deepseek

# DeepSeek API Configuration (required if LLM_PROVIDER=deepseek)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Configuration (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# Public demo: disables profile edits, LinkedIn import and history deletion
DEMO_MODE=false

# Optional: Flask secret key for sessions
FLASK_SECRET_KEY=your_secret_key_here
